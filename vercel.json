{
  "version": 2,
  "builds": [
    {
      "src": "dailystatus/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/styles\\.css",
      "dest": "dailystatus/wsgi.py",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/app\\.js",
      "dest": "dailystatus/wsgi.py",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/(volgo-logo\\.png|volgo-icon\\.png|favicon\\.ico)",
      "dest": "dailystatus/wsgi.py",
      "headers": {
        "cache-control": "public, max-age=604800, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "dailystatus/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "dailystatus.settings"
  }
}
